# Copy this file to .env and adjust the values for your machine.

# Postgres connection string for the app database (created by `npm run db:create`).
DATABASE_URL=postgres://postgres:your_password@localhost:5432/support_desk

# Separate database used by the integration tests. It is wiped on every test run,
# so never point it at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgres://postgres:your_password@localhost:5432/support_desk_test

# Secret used to sign login tokens. Use a long random string outside local development.
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000
CORS_ORIGIN=http://localhost:5173

# Response-time target: a ticket breaches SLA if it gets no public reply within this many hours.
SLA_FIRST_RESPONSE_HOURS=4

# AI Support Copilot (optional). Without OPENAI_API_KEY the copilot reports that it is
# not configured and the rest of the app works normally. Keep the key in this server-side
# file only: never put it in client/ or in a VITE_* variable.
OPENAI_API_KEY=
# Any OpenAI chat model that supports Structured Outputs (json_schema).
OPENAI_MODEL=gpt-4o-mini
# Optional: an OpenAI-compatible endpoint. Defaults to https://api.openai.com/v1
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: give up on an analysis after this many milliseconds (default 20000).
# OPENAI_TIMEOUT_MS=20000

# SLA escalation. A ticket is escalated (level 1) when its first-response SLA is breached and
# to senior attention (level 2) when there is still no public reply this many hours later.
# SLA_ESCALATION_LEVEL2_HOURS=2
# How often the API checks for tickets to escalate, in seconds (default 60).
# ESCALATION_CHECK_INTERVAL_SECONDS=60
# Set to false to turn off the periodic check (e.g. when running `npm run escalations:check` from cron).
# ESCALATION_CHECK_ENABLED=true
